    <div class="ss-navbar-left">

        <!-- Hamburger -->
        <button type="button"
                class="ss-menu-btn"
                onclick="openShopSphereMenu()"
                aria-label="Open menu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <!-- ShopSphere Logo -->
        <a href=" /"
           class="ss-logo">
            Shop<span>Sphere</span>
        </a>

    </div>

    <!-- Logout -->
    <a href=" /logout"
       class="ss-logout">
        Logout
    </a>

</nav>


<!-- Dark overlay -->
<div id="ss-menu-overlay"
     class="ss-menu-overlay"
     onclick="closeShopSphereMenu()">
</div>


<!-- Side Menu -->
<aside id="ss-side-menu" class="ss-side-menu">

    <!-- Sidebar Header -->
    <div class="ss-sidebar-header">

        <div>
            <div class="ss-sidebar-logo">
                Shop<span>Sphere</span>
            </div>

            <div class="ss-sidebar-subtitle">
                Your E-Commerce Store
            </div>
        </div>

        <button type="button"
                class="ss-close-btn"
                onclick="closeShopSphereMenu()">
            ×
        </button>

    </div>


    <!-- Main Links -->
    <div class="ss-menu-section">

        <a href=" /"
           class="ss-menu-link ss-active">
            <span class="ss-menu-icon">⌂</span>
            <span>Home</span>
        </a>

        <a href=" /products"
           class="ss-menu-link">
            <span class="ss-menu-icon">🛍️</span>
            <span>Products</span>
        </a>

        <a href=" /cart"
           class="ss-menu-link">
            <span class="ss-menu-icon">🛒</span>
            <span>Cart</span>
