</aside>


<style>

    /* ================================
       SHOPSPHERE NAVBAR
       ================================ */

    .ss-navbar {
        width: 100%;
        height: 74px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 0 18px 0 22px;

        background: #202020;

        position: relative;
        z-index: 1000;

        box-shadow: 0 4px 18px rgba(0,0,0,.16);
    }


    .ss-navbar-left {
        display: flex;
        align-items: center;
        gap: 18px;
    }


    /* Hamburger */

    .ss-menu-btn {
        width: 48px;
        height: 44px;

        border: none;
        border-radius: 10px;

        background: rgba(255,255,255,.10);

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        gap: 5px;

        cursor: pointer;

        transition: .2s ease;
    }

    .ss-menu-btn:hover {
        background: rgba(255,255,255,.18);
        transform: scale(1.04);
    }


    .ss-menu-btn span {
        width: 25px;
        height: 3px;

        border-radius: 5px;

        background: white;

        display: block;
    }


    /* ShopSphere Logo */

    .ss-logo {
        text-decoration: none;

        font-size: 32px;
        font-weight: 900;
        letter-spacing: -1.2px;

        color: white;

        line-height: 1;
    }


    .ss-logo span {
        background: linear-gradient(
            90deg,
            #2563eb,
            #3b82f6,
            #7c3aed
        );

        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;

        background-clip: text;
    }


    /* Logout */

    .ss-logout {
        text-decoration: none;

        padding: 10px 18px;

        border-radius: 9px;

        background: #ff4545;

        color: white;

        font-size: 16px;
        font-weight: 700;

        transition: .2s ease;
    }


    .ss-logout:hover {
        background: #e93636;
        transform: translateY(-1px);
    }


    /* ================================
       OVERLAY
       ================================ */

    .ss-menu-overlay {
        position: fixed;

        inset: 0;

        background: rgba(0,0,0,.42);

        opacity: 0;
        visibility: hidden;

        transition: .25s ease;

        z-index: 1100;
    }


    .ss-menu-overlay.ss-show {
        opacity: 1;
        visibility: visible;
    }


    /* ================================
       SIDE MENU
       ================================ */

    .ss-side-menu {
        position: fixed;

        top: 0;
        left: 0;

        width: 360px;
        max-width: 88vw;
        height: 100vh;

        background: rgba(255,255,255,.98);

        box-shadow: 10px 0 40px rgba(0,0,0,.18);

        z-index: 1200;

        transform: translateX(-105%);

        transition: transform .28s ease;

        padding: 28px 22px;

        overflow-y: auto;
    }


    .ss-side-menu.ss-open {
        transform: translateX(0);
    }


    /* Sidebar Header */

    .ss-sidebar-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;

        padding: 8px 4px 25px;
    }


    .ss-sidebar-logo {
        font-size: 27px;
        font-weight: 900;
        letter-spacing: -.8px;

        color: #111827;
    }


    .ss-sidebar-logo span {
        background: linear-gradient(
            90deg,
            #2563eb,
            #7c3aed
        );

        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;

        background-clip: text;
    }


    .ss-sidebar-subtitle {
        margin-top: 5px;

        color: #64748b;

        font-size: 14px;
    }


    /* Close */

    .ss-close-btn {
        width: 38px;
        height: 38px;

        border: none;

        background: transparent;

        color: #64748b;

        font-size: 32px;
        line-height: 1;

        cursor: pointer;

        border-radius: 8px;
    }


    .ss-close-btn:hover {
        background: #f1f5f9;
        color: #111827;
    }


    /* Menu Links */

    .ss-menu-section {
        display: flex;
        flex-direction: column;

        gap: 5px;
    }


    .ss-menu-link {
        display: flex;
        align-items: center;

        gap: 18px;

        width: 100%;

        padding: 14px 16px;

        border-radius: 14px;

        color: #1e293b;

        text-decoration: none;

        font-size: 17px;
        font-weight: 600;

        transition: .2s ease;
    }


    .ss-menu-link:hover {
        background: #eef2ff;

        color: #4f46e5;

        transform: translateX(3px);
    }


    .ss-menu-link.ss-active {
        background: linear-gradient(
            135deg,
            #eef2ff,
            #e9e7ff
        );

        color: #4f46e5;
    }


    .ss-menu-icon {
        width: 30px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        font-size: 21px;

        color: #64748b;
    }


    .ss-menu-link:hover .ss-menu-icon,
    .ss-menu-link.ss-active .ss-menu-icon {
        color: #4f46e5;
    }


    /* Divider */

    .ss-menu-divider {
        height: 1px;

        background: #e2e8f0;

        margin: 20px 4px;
    }


    /* ================================
       MOBILE
       ================================ */

    @media (max-width: 600px) {

        .ss-navbar {
            height: 68px;

            padding: 0 12px 0 14px;
        }

        .ss-navbar-left {
            gap: 12px;
        }

        .ss-menu-btn {
            width: 43px;
            height: 40px;
        }

        .ss-logo {
            font-size: 25px;
        }

        .ss-logout {
            padding: 9px 13px;
            font-size: 14px;
        }

        .ss-side-menu {
            width: 330px;
        }
    }

</style>


<script>

    function openShopSphereMenu() {

        const menu = document.getElementById("ss-side-menu");
        const overlay = document.getElementById("ss-menu-overlay");

        if (menu && overlay) {

            menu.classList.add("ss-open");
            overlay.classList.add("ss-show");

            document.body.style.overflow = "hidden";
        }
    }


    function closeShopSphereMenu() {

        const menu = document.getElementById("ss-side-menu");
        const overlay = document.getElementById("ss-menu-overlay");

        if (menu && overlay) {

            menu.classList.remove("ss-open");
            overlay.classList.remove("ss-show");

            document.body.style.overflow = "";
        }
    }


    /* ESC key se menu close */

    document.addEventListener("keydown", function(event) {

        if (event.key === "Escape") {
            closeShopSphereMenu();
        }

    });

</script>